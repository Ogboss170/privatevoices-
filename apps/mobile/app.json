{
  "expo": {
    "name": "Private Voices",
    "slug": "privatevoices",
    "owner": "fytro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "privatevoices",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.privatevoices",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Private Voices needs camera access so you can capture and share photos and videos.",
        "NSMicrophoneUsageDescription": "Private Voices needs microphone access for voice notes and voice calls.",
        "NSPhotoLibraryUsageDescription": "Private Voices needs photo library access to upload avatars and post attachments.",
        "UIBackgroundModes": ["fetch", "remote-notification", "audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "app.privatevoices",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "notification": {
        "icon": "./assets/images/notification-icon.png",
        "color": "#6366f1"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Private Voices needs access to your photos to upload a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ae40d348-f06a-4426-ba93-8520ea36ca0e"
      }
    }
  }
}
